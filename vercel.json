{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run check",
  "outputDirectory": "public",
  "functions": {"api/index.mjs": {"includeFiles": "public/**", "maxDuration": 60}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/media/:path*", "destination": "/api/index"}
  ],
  "headers": [{"source": "/(.*)", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: blob:; connect-src 'self' https://sedyckmbnyydsfjoycuz.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"}
  ]}]
}
